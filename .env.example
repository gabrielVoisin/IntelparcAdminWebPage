# Copy to .env and change every value.
DOMAIN=parking.example.com
POSTGRES_PASSWORD=change-me-long-random
# 64 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
APP_ENV=production
COOKIE_SECURE=true
DEFAULT_LOCALE=fr
# Only needed if another web origin calls the API from a browser (the Android app does not need CORS)
CORS_ORIGINS=
# Bluetooth identity tokens of the driver app: base64 of 32 random bytes (empty = derived from JWT_SECRET)
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
BLE_SIGNING_KEY=
# Prototype only: return the SMS code to the app instead of sending an SMS
SMS_DEBUG=false
